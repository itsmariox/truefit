  "compilerOptions": {
    "target": "es2024", "module": "esnext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true, "skipLibCheck": true, "jsx": "react-jsx", "types": ["node"], "lib": ["es2024", "dom", "dom.iterable"]
